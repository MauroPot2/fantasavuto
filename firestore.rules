rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && request.auth.token.get('email_verified', false) == true;
    }

    function adminEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/admins/$(adminEmail()));
    }

    function isShortText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalHttpsUrl(value) {
      return value is string
        && value.size() <= 2048
        && (value == '' || value.matches('^https://.+'));
    }

    function validCompetitionId(competitionId) {
      return competitionId is string
        && competitionId.size() > 0
        && competitionId.size() <= 80
        && competitionId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function competitionExists(competitionId) {
      return validCompetitionId(competitionId)
        && exists(/databases/$(database)/documents/competitions/$(competitionId));
    }

    function competitionNameMatches(competitionId, competitionName) {
      return competitionExists(competitionId)
        && get(/databases/$(database)/documents/competitions/$(competitionId)).data.name == competitionName;
    }

    function validWinner() {
      return request.resource.data.keys().hasOnly([
          'competitionId',
          'competitionName',
          'title',
          'team',
          'manager',
          'score',
          'matchday',
          'date',
          'updatedAt'
        ])
        && competitionNameMatches(
          request.resource.data.competitionId,
          request.resource.data.competitionName
        )
        && isShortText(request.resource.data.competitionName, 80)
        && isShortText(request.resource.data.title, 90)
        && isShortText(request.resource.data.team, 80)
        && request.resource.data.manager is string
        && request.resource.data.manager.size() <= 80
        && (request.resource.data.score is int
          || request.resource.data.score is float)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 300
        && request.resource.data.matchday is int
        && request.resource.data.matchday >= 1
        && request.resource.data.matchday <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.updatedAt is timestamp;
    }

    function validRegulation() {
      return request.resource.data.keys().hasOnly([
          'season',
          'updatedAt'
        ])
        && isShortText(request.resource.data.season, 20)
        && request.resource.data.updatedAt is timestamp;
    }

    function validHistoryWinner() {
      return request.resource.data.keys().hasOnly([
          'competitionId',
          'competitionName',
          'title',
          'team',
          'manager',
          'score',
          'matchday',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && competitionNameMatches(
          request.resource.data.competitionId,
          request.resource.data.competitionName
        )
        && isShortText(request.resource.data.competitionName, 80)
        && isShortText(request.resource.data.title, 90)
        && isShortText(request.resource.data.team, 80)
        && request.resource.data.manager is string
        && request.resource.data.manager.size() <= 80
        && (request.resource.data.score is int || request.resource.data.score is float)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 300
        && request.resource.data.matchday is int
        && request.resource.data.matchday >= 1
        && request.resource.data.matchday <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validRegulationSection() {
      return request.resource.data.keys().hasOnly([
          'title', 'markdown', 'active', 'order', 'createdAt', 'updatedAt'
        ])
        && isShortText(request.resource.data.title, 100)
        && isShortText(request.resource.data.markdown, 30000)
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPrize() {
      return request.resource.data.keys().hasOnly([
          'competitionId', 'competitionName', 'title', 'amount',
          'description', 'active', 'order', 'createdAt', 'updatedAt'
        ])
        && (
          (
            request.resource.data.competitionId == 'general'
            && request.resource.data.competitionName == 'Premio generale'
          )
          || competitionNameMatches(
            request.resource.data.competitionId,
            request.resource.data.competitionName
          )
        )
        && isShortText(request.resource.data.competitionName, 80)
        && isShortText(request.resource.data.title, 100)
        && isShortText(request.resource.data.amount, 50)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSponsor() {
      return request.resource.data.keys().hasOnly([
          'name',
          'logoUrl',
          'storagePath',
          'websiteUrl',
          'active',
          'order',
          'createdAt',
          'updatedAt'
        ])
        && isShortText(request.resource.data.name, 100)
        && isShortText(request.resource.data.logoUrl, 2048)
        && request.resource.data.logoUrl.matches('^https://.+')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() <= 500
        && request.resource.data.websiteUrl is string
        && request.resource.data.websiteUrl.size() <= 2048
        && (
          request.resource.data.websiteUrl == ''
          || request.resource.data.websiteUrl.matches('^https?://.+')
        )
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSiteSettings() {
      return request.resource.data.keys().hasOnly([
          'leagueName',
          'season',
          'editionLabel',
          'currentMatchday',
          'sponsorBarEnabled',
          'sponsorBarTitle',
          'sponsorBarDescription',
          'sponsorBarSpeedSeconds',
          'updatedAt'
        ])
        && isShortText(request.resource.data.leagueName, 80)
        && isShortText(request.resource.data.season, 20)
        && isShortText(request.resource.data.editionLabel, 30)
        && request.resource.data.currentMatchday is int
        && request.resource.data.currentMatchday >= 0
        && request.resource.data.currentMatchday <= 60
        && request.resource.data.sponsorBarEnabled is bool
        && isShortText(request.resource.data.sponsorBarTitle, 80)
        && isShortText(request.resource.data.sponsorBarDescription, 180)
        && request.resource.data.sponsorBarSpeedSeconds is int
        && request.resource.data.sponsorBarSpeedSeconds >= 10
        && request.resource.data.sponsorBarSpeedSeconds <= 120
        && request.resource.data.updatedAt is timestamp;
    }

    function validTeam() {
      return request.resource.data.keys().hasOnly([
          'name',
          'manager',
          'logoUrl',
          'active',
          'order',
          'season',
          'createdAt',
          'updatedAt'
        ])
        && isShortText(request.resource.data.name, 80)
        && isShortText(request.resource.data.manager, 80)
        && isOptionalHttpsUrl(request.resource.data.logoUrl)
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && isShortText(request.resource.data.season, 20)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validCompetition(competitionId) {
      return validCompetitionId(competitionId)
        && request.resource.data.keys().hasOnly([
          'name',
          'tagline',
          'description',
          'accent',
          'active',
          'order',
          'season',
          'createdAt',
          'updatedAt'
        ])
        && isShortText(request.resource.data.name, 80)
        && isShortText(request.resource.data.tagline, 80)
        && isShortText(request.resource.data.description, 500)
        && request.resource.data.accent in ['lime', 'orange', 'blue', 'pink']
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && isShortText(request.resource.data.season, 20)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /admins/{email} {
      allow get: if hasVerifiedEmail()
        && email == adminEmail();
      allow list, create, update, delete: if false;
    }

    match /siteMetrics/{documentId} {
      allow get: if documentId == 'visits';
      allow list, delete: if false;
      allow create: if documentId == 'visits'
        && request.resource.data.keys().hasOnly(['total', 'updatedAt'])
        && request.resource.data.total is int
        && request.resource.data.total == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if documentId == 'visits'
        && request.resource.data.keys().hasOnly(['total', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'updatedAt'])
        && resource.data.total is int
        && request.resource.data.total is int
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.updatedAt == request.time;
    }

    match /siteSettings/{documentId} {
      allow get: if documentId == 'current';
      allow list: if false;
      allow create, update: if documentId == 'current'
        && isAdmin()
        && validSiteSettings();
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validTeam();
      allow delete: if isAdmin();
    }

    match /competitions/{competitionId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validCompetition(competitionId);
      allow delete: if false;
    }

    match /siteContent/{documentId} {
      allow get: if documentId in ['currentWinner', 'regulation'];
      allow list: if false;
      allow create, update: if isAdmin()
        && (
          (documentId == 'currentWinner' && validWinner())
          || (documentId == 'regulation' && validRegulation())
        );
      allow delete: if false;
    }

    match /sponsors/{sponsorId} {
      allow get: if isAdmin() || resource.data.active == true;
      allow list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validSponsor();
      allow delete: if isAdmin();
    }

    match /competitionWinners/{winnerId} {
      allow read: if true;
      allow create, update: if isAdmin() && validHistoryWinner();
      allow delete: if isAdmin();
    }

    match /regulationSections/{sectionId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validRegulationSection();
      allow delete: if isAdmin();
    }

    match /prizes/{prizeId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validPrize();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
